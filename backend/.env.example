# Environment
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
DATABASE_NAME=cirs_db

# JWT
SECRET_KEY=generate_a_secure_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password # Get from: Google Account > Security > App Passwords
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=CIRS Platform

# Cloudinary (optional file upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name # Get from Cloudinary Dashboard
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# App
APP_ENV=production
FRONTEND_URL=https://your-frontend-url.onrender.com
