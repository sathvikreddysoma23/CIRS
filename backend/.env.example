# Environment
MONGO_URI=mongodb+srv://CIRS_DB:CIRS@cirs.55wsmp4.mongodb.net/?appName=CIRS
DATABASE_NAME=cirs_db

# JWT
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
